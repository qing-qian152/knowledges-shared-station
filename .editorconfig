# 让不同编辑器（VS Code / Vim / PyCharm）在这台机器上产出同一份字节。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown 里行尾两个空格是有意义的换行，不能被裁掉
trim_trailing_whitespace = false

[*.{woff2,png,ico}]
# 二进制，编辑器不要试图重排
insert_final_newline = false
trim_trailing_whitespace = false
